// Solana Alpha Desk — control-plane Worker (API + dashboard static assets).
// Deployed to https://magpie.paruto.com (see docs/deployment.md).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "solana-alpha-desk-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "magpie.paruto.com", "custom_domain": true }],
  "assets": {
    "directory": "../web/out",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/internal/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solana-alpha-desk",
      "database_id": "e01c7217-af7a-48ad-bbb0-e8ec4a5829b9",
      "migrations_dir": "../../infrastructure/migrations",
    },
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "solana-alpha-desk-evidence" }],
  "queues": { "producers": [{ "binding": "CANDIDATE_QUEUE", "queue": "alpha-desk-candidates" }] },
  "vars": { "APP_ENV": "production" },
  "observability": { "enabled": true },
}
