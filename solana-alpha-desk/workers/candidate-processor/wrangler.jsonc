// Part of Solana Alpha Desk (see docs/deployment.md). No public route.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alpha-desk-candidate-processor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solana-alpha-desk",
      "database_id": "e01c7217-af7a-48ad-bbb0-e8ec4a5829b9",
    },
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "solana-alpha-desk-evidence" }],
  "queues": {
    "producers": [{ "binding": "CANDIDATE_QUEUE", "queue": "alpha-desk-candidates" }],
    "consumers": [
      {
        "queue": "alpha-desk-candidates",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        // One consumer at a time: provider rate limits (Helius Free: 2 req/s) are paced per invocation.
        "max_concurrency": 1,
        "dead_letter_queue": "alpha-desk-candidates-dlq",
      },
    ],
  },
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true },
}
