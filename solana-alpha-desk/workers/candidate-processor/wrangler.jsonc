// Not deployed — see docs/deployment.md. Resource IDs are placeholders.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "alpha-desk-candidate-processor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solana-alpha-desk",
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [{ "binding": "EVIDENCE", "bucket_name": "solana-alpha-desk-evidence" }],
  "queues": {
    "producers": [{ "binding": "CANDIDATE_QUEUE", "queue": "alpha-desk-candidates" }],
    "consumers": [
      {
        "queue": "alpha-desk-candidates",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 5,
        "dead_letter_queue": "alpha-desk-candidates-dlq",
      },
    ],
  },
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true },
}
