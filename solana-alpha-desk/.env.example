# Solana Alpha Desk — environment. Copy to .env (never commit real values).
# Local single-host operation (node:sqlite):
DATABASE_PATH=data/alpha-desk.sqlite
EVIDENCE_DIR=data/evidence
TIMEZONE=UTC
INITIAL_MODE=DISCOVERY_ONLY          # STOPPED | DISCOVERY_ONLY | PAPER_MANUAL | PAPER_AUTONOMOUS | EMERGENCY_PAUSED
RUN_PIPELINE=true                    # false when Cloudflare cron + queues run discovery/filter/analyst
OWNER_EMAIL=owner@example.com
LOG_LEVEL=info
APP_ENV=development                  # production requires BRIDGE_URL and MFA for admin actions

# API (local server and Worker secret): one-time token required to create the owner account.
SETUP_TOKEN=
COOKIE_SECURE=false                  # true behind HTTPS (the Worker always sets Secure)
PORT=8787

# Production monitor → API Worker → D1 (signed SQL bridge). Same BRIDGE_SECRET on both sides, 32+ chars.
BRIDGE_URL=
BRIDGE_SECRET=

# Market data (optional credentials; see docs/data-sources.md)
SOLANA_RPC_URL=                      # a private RPC is strongly recommended
JUPITER_API_KEY=                     # api.jup.ag; empty uses lite-api.jup.ag
HELIUS_API_KEY=                      # BLOCKED_BY_CREDENTIALS until set: holder clustering, developer graph, bundling, trade flow

# Optional AI summaries of reports (never used for decisions)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
