# WealthOS environment. Copy to .env.local for development. Never commit real secrets.

# Runtime connection: the NON-OWNER role, so Postgres row-level security applies.
DATABASE_URL=postgres://wealthos_app:wealthos_app_dev@localhost:5432/wealthos_dev
# Migration/seed connection: the schema OWNER role. Not used by the running app.
DATABASE_OWNER_URL=postgres://wealthos_owner:wealthos_owner_dev@localhost:5432/wealthos_dev
# Name of the runtime role (granted privileges by migrations).
DATABASE_APP_ROLE=wealthos_app

# 32-byte key, base64. Encrypts MFA secrets at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Public origin of the app (used in emails and for Origin checks).
APP_ORIGIN=http://localhost:3100

# Email delivery. "outbox" stores messages in the email_outbox table (dev/test only).
# No production email provider is integrated yet.
EMAIL_TRANSPORT=outbox

# Password hashing cost (scrypt log2 N). 17 in production; tests may lower it.
SCRYPT_LOG_N=17

# AI provider: not integrated in Milestone 1/2.
# ANTHROPIC_API_KEY=
